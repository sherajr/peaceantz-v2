---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Peace Antz"
  description="This trail leads nowhere — let’s get you back to the colony."
>
  <section class="section" style="padding-top: 6rem; padding-bottom: 6rem">
    <div class="container center">
      <span class="kicker">404</span>
      <h1>This trail leads nowhere</h1>
      <p class="lead" style="margin-inline: auto">
        Even scout ants take a wrong turn sometimes. The page you’re looking
        for isn’t here — it may have moved when the site was rebuilt.
      </p>
      <div class="hero__actions" style="margin-top: 1.6rem">
        <a class="btn btn--gold" href="/">Back home</a>
        <a class="btn btn--outline" href="/create">Make a quote card instead</a>
      </div>
    </div>
  </section>
</Base>
