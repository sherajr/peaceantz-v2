{
  // Cloudflare Workers config: static Astro build + one Worker route.
  // Deploy: npm run deploy   (first time: npx wrangler login)
  // Secrets to set before the contact form goes live:
  //   npx wrangler secret put RESEND_API_KEY
  //   and set CONTACT_EMAIL_TO below (or as a secret).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peaceantz",
  "main": "worker/index.ts",
  // Kept explicit: the workers.dev route once pinned itself to a stale version
  // while the API reported the new one at 100%. Toggling this false -> deploy ->
  // true -> deploy re-registers the route and clears it.
  "workers_dev": true,
  // Live site. The apex is the canonical host (attached via the dashboard);
  // www is attached here only so existing links keep working — the Worker 301s
  // it to the apex. Rollback records are noted in docs/local/ (gitignored).
  // NOTE: this list is declarative — wrangler REMOVES any custom domain not
  // named here, so the apex must stay listed even though it was first attached
  // in the dashboard. The apex is canonical; the Worker 301s www to it.
  "routes": [
    { "pattern": "peaceantz.com", "custom_domain": true },
    { "pattern": "www.peaceantz.com", "custom_domain": true }
  ],
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Powers POST /api/translate in the Quote Card Creator. Remove this binding
  // and the creator falls back to letting people paste their own translation.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // "CONTACT_EMAIL_TO": "you@example.com"
    // "TRANSLATE_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}
